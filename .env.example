# Atlas environment variables — copy this file to `.env` and fill in real values.
# `.env` itself is gitignored. Never commit a real key.

# Anthropic API key — required for all agent runs.
# Get one at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Default model for development. Sonnet is the right balance of cost and quality.
# Switch to claude-opus-4-7 only for demo polish runs.
ATLAS_DEFAULT_MODEL=claude-sonnet-4-6
