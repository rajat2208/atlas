# Atlas environment variables — copy this file to `.env` and fill in real values.
# `.env` itself is gitignored. Never commit a real key.

# Anthropic API key — required for all agent runs.
# Get one at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Default model for development. Haiku 4.5 is the cheapest current-gen Claude;
# good enough for most pattern detection. Per-detector overrides can upgrade
# to claude-sonnet-4-6 (3x cost) or claude-opus-4-7 (~15x cost) where eval
# shows quality issues — see docs/atlas-prd.md §8.
ATLAS_DEFAULT_MODEL=claude-haiku-4-5-20251001
